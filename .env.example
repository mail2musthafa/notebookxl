NOTEBOOKXL_ENV=development
NOTEBOOKXL_APP_NAME=NotebookXL API
NOTEBOOKXL_DEBUG=true

NOTEBOOKXL_DATABASE_URL=postgresql+psycopg://notebookxl:notebookxl@localhost:5432/notebookxl
NOTEBOOKXL_REDIS_URL=redis://localhost:6379/0

NOTEBOOKXL_SECRET_KEY=replace-with-strong-secret
NOTEBOOKXL_ACCESS_TOKEN_EXPIRE_MINUTES=30
NOTEBOOKXL_REFRESH_TOKEN_EXPIRE_DAYS=30

NOTEBOOKXL_ALLOWED_ORIGINS=http://localhost:3000
NOTEBOOKXL_FRONTEND_URL=http://localhost:3000

NOTEBOOKXL_DEFAULT_AI_PROVIDER=local
NOTEBOOKXL_OPENAI_API_KEY=
NOTEBOOKXL_GEMINI_API_KEY=
NOTEBOOKXL_ANTHROPIC_API_KEY=